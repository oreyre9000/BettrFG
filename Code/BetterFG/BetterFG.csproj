<Project Sdk="Microsoft.NET.Sdk">

	<!-- Build hash = SHA256 of all .cs source files in the project, truncated to 16 hex chars.
	     Deterministic: same source tree → same hash on any machine. Source change → new hash.
	     Lands in obj\...\BuildHash.g.cs as a partial of BetterFGInfo. -->
	<PropertyGroup>
	  <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
	  <!-- all default off. CopyBuildsToSteam / CopyBuildsToEpic drop the plugin into that store's Fall Guys
	       (folders auto-discovered like the installer does); CopyBuildsToDownloads drops the built installer
	       exe + bettrfg_plugin.zip into Downloads. plain build does none. -->
	  <CopyBuildsToSteam Condition="'$(CopyBuildsToSteam)' == ''">false</CopyBuildsToSteam>
	  <CopyBuildsToEpic Condition="'$(CopyBuildsToEpic)' == ''">false</CopyBuildsToEpic>
	  <CopyBuildsToDownloads Condition="'$(CopyBuildsToDownloads)' == ''">false</CopyBuildsToDownloads>
	  <BettrFGDownloadsFlag Condition="'$(CopyBuildsToDownloads)' == 'true'">-CopyBuildsToDownloads</BettrFGDownloadsFlag>
	</PropertyGroup>
	<UsingTask TaskName="ComputeBettrFGSourceHash" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
	  <ParameterGroup>
	    <ProjectDir ParameterType="System.String" Required="true" />
	    <ExtraDir ParameterType="System.String" Required="false" />
	    <HashValue ParameterType="System.String" Output="true" />
	  </ParameterGroup>
	  <Task>
	    <Using Namespace="System" />
	    <Using Namespace="System.IO" />
	    <Using Namespace="System.Linq" />
	    <Using Namespace="System.Security.Cryptography" />
	    <Code Type="Fragment" Language="cs"><![CDATA[
	      var dirs = string.IsNullOrEmpty(ExtraDir)
	        ? new[] { ProjectDir }
	        : new[] { ProjectDir, ExtraDir };
	      using (var sha = SHA256.Create())
	      {
	        foreach (var dir in dirs)
	        {
	          var files = Directory.GetFiles(dir, "*.cs", SearchOption.AllDirectories)
	                               .Where(f => f.IndexOf("\\obj\\", StringComparison.OrdinalIgnoreCase) < 0
	                                        && f.IndexOf("\\bin\\", StringComparison.OrdinalIgnoreCase) < 0)
	                               .OrderBy(f => f, StringComparer.Ordinal)
	                               .ToArray();
	          foreach (var f in files)
	          {
	            var rel = System.Text.Encoding.UTF8.GetBytes(f.Substring(dir.Length).Replace('\\','/') + "\n");
	            sha.TransformBlock(rel, 0, rel.Length, null, 0);
	            var bytes = File.ReadAllBytes(f);
	            sha.TransformBlock(bytes, 0, bytes.Length, null, 0);
	          }
	        }
	        sha.TransformFinalBlock(new byte[0], 0, 0);
	        HashValue = BitConverter.ToString(sha.Hash).Replace("-", "").ToLowerInvariant().Substring(0, 16);
	      }
	    ]]></Code>
	  </Task>
	</UsingTask>
	<Target Name="GenerateBuildHash" BeforeTargets="BeforeCompile;CoreCompile">
	  <PropertyGroup>
	    <BuildHashFile>$(IntermediateOutputPath)BuildHash.g.cs</BuildHashFile>
	    <BettrFGVersionLabel Condition="'$(BettrFGVersionLabel)' == ''">$(BettrFGVersion)</BettrFGVersionLabel>
	  </PropertyGroup>
	  <MakeDir Directories="$(IntermediateOutputPath)" />
	  <ComputeBettrFGSourceHash ProjectDir="$(MSBuildProjectDirectory)\" ExtraDir="$(MSBuildProjectDirectory)\..\BetterFG.uGUI\">
	    <Output TaskParameter="HashValue" PropertyName="BuildHashValue" />
	  </ComputeBettrFGSourceHash>
	  <ItemGroup>
	    <_BuildHashContent Include="namespace BetterFG.Core { public static partial class BetterFGInfo { public const string BuildHash = &quot;$(BuildHashValue)&quot;%3B public const string VersionLabel = &quot;$(BettrFGVersionLabel)&quot;%3B } }" />
	  </ItemGroup>
	  <WriteLinesToFile File="$(BuildHashFile)" Lines="@(_BuildHashContent)" Overwrite="true" WriteOnlyWhenDifferent="false" />
	  <ItemGroup>
	    <Compile Include="$(BuildHashFile)" />
	  </ItemGroup>
	</Target>

	<!-- Fall Guys locks BetterFG.dll while running, which makes CopyDll fail with retries. Hard-kill the
	     game before we compile so the plugin file is free. Best-effort: taskkill returns non-zero if the
	     process isn't running, so ignore the exit code.
	     KillAndRestartGame is checked per-task, NOT on the target: MSBuild evaluates a target's
	     Condition BEFORE the BeforeTargets that precede it, so a target-level check here reads the
	     value from before the prompt ran and "Compile only" kills the game anyway. -->
	<Target Name="KillFallGuysBeforeBuild" BeforeTargets="BeforeBuild" Condition="'$(SkipCopyDll)' != 'true'">
	  <Exec Command="taskkill /F /IM FallGuys_client_game.exe /T" ContinueOnError="true" Condition="'$(KillAndRestartGame)' != 'false'" />
	  <Exec Command="taskkill /F /IM FallGuys_client.exe /T" ContinueOnError="true" Condition="'$(KillAndRestartGame)' != 'false'" />
	  <Exec Command="powershell -NoProfile -Command &quot;$sw=[Diagnostics.Stopwatch]::StartNew(); while(($sw.Elapsed.TotalSeconds -lt 15) -and ((Get-Process FallGuys_client_game -ErrorAction SilentlyContinue) -or (Get-Process FallGuys_client -ErrorAction SilentlyContinue))) { Start-Sleep -Milliseconds 200 }&quot;" ContinueOnError="true" Condition="'$(KillAndRestartGame)' != 'false'" />
	  <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\BetterFG.Installer\close_installer.ps1&quot;" ContinueOnError="true" Condition="'$(KillAndRestartGame)' != 'false'" />
	</Target>

	<!-- Inside VS only: pop a little checkbox dialog before the build so you can pick which copy steps
	     run, instead of hardcoding /p: flags. Command-line MSBuild never sets BuildingInsideVisualStudio,
	     so scripted/CI builds skip it and honor whatever flags were passed. Pass /p:NoBuildPrompt=true
	     (or set <NoBuildPrompt>true</NoBuildPrompt> in a config/.user file) to skip it in VS too. -->
	<Target Name="BettrFGBuildPrompt" BeforeTargets="KillFallGuysBeforeBuild;BeforeBuild"
	        Condition="'$(BuildingInsideVisualStudio)' == 'true' And '$(NoBuildPrompt)' != 'true' And '$(DesignTimeBuild)' != 'true' And '$(SkipCopyDll)' != 'true'">
	  <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -STA -File &quot;$(MSBuildProjectDirectory)\..\prompt_mod.ps1&quot;" ConsoleToMSBuild="true">
	    <Output TaskParameter="ConsoleOutput" PropertyName="BettrFGPromptOut" />
	  </Exec>
	  <PropertyGroup>
	    <CopyBuildsToSteam Condition="$(BettrFGPromptOut.Contains('STEAM=1'))">true</CopyBuildsToSteam>
	    <CopyBuildsToSteam Condition="$(BettrFGPromptOut.Contains('STEAM=0'))">false</CopyBuildsToSteam>
	    <CopyBuildsToEpic Condition="$(BettrFGPromptOut.Contains('EPIC=1'))">true</CopyBuildsToEpic>
	    <CopyBuildsToEpic Condition="$(BettrFGPromptOut.Contains('EPIC=0'))">false</CopyBuildsToEpic>
	    <CopyBuildsToDownloads Condition="$(BettrFGPromptOut.Contains('DL=1'))">true</CopyBuildsToDownloads>
	    <CopyBuildsToDownloads Condition="$(BettrFGPromptOut.Contains('DL=0'))">false</CopyBuildsToDownloads>
	    <BettrFGDownloadsFlag Condition="$(BettrFGPromptOut.Contains('DL=1'))">-CopyBuildsToDownloads</BettrFGDownloadsFlag>
	    <BettrFGDownloadsFlag Condition="$(BettrFGPromptOut.Contains('DL=0'))"></BettrFGDownloadsFlag>
	    <BettrFGVersionLabel Condition="$(BettrFGPromptOut.Contains('VER='))">$([System.Text.RegularExpressions.Regex]::Match($(BettrFGPromptOut), 'VER=([^%3B]*)').Groups[1].Value)</BettrFGVersionLabel>
	    <KillAndRestartGame Condition="$(BettrFGPromptOut.Contains('KILL=0'))">false</KillAndRestartGame>
	    <SkipLaunch Condition="$(BettrFGPromptOut.Contains('KILL=0'))">true</SkipLaunch>
	    <!-- early access drives IsPublicRelease, which is what puts the "not for public release" +
	         "Early access!" lines on the watermark. The unchecked case has to actively strip the constant,
	         otherwise picking an EarlyAcesss Configuration in VS would keep stamping those lines on
	         a build the window says is a normal one. -->
	    <DefineConstants Condition="$(BettrFGPromptOut.Contains('EA=1'))">$(DefineConstants);EARLYACESSS</DefineConstants>
	    <DefineConstants Condition="$(BettrFGPromptOut.Contains('EA=0'))">$(DefineConstants.Replace('EARLYACESSS', ''))</DefineConstants>
	    <DefineConstants Condition="$(BettrFGPromptOut.Contains('MACH=1'))">$(DefineConstants);MACHINIMA</DefineConstants>
	    <DefineConstants Condition="$(BettrFGPromptOut.Contains('MACH=0'))">$(DefineConstants.Replace('MACHINIMA', ''))</DefineConstants>
	  </PropertyGroup>
	  <Message Importance="high" Text="BettrFG build choices: $(BettrFGPromptOut)" />
	</Target>

	<!-- the plugin's resolver loads these out of Libs/ at runtime, and repack_payload ships that folder
	     as-is. they're vendored binaries under Libs\ rather than NuGet packages so a clone builds the
	     exact DLLs that ship - drop a dll in the folder and it's referenced and shipped, no csproj edit. -->
	<Target Name="CopyLibs" AfterTargets="Build">
	  <ItemGroup>
	    <BettrFGLib Include="$(MSBuildProjectDirectory)\Libs\*.dll" />
	  </ItemGroup>
	  <Copy SourceFiles="@(BettrFGLib)" DestinationFolder="$(OutDir)Libs" SkipUnchangedFiles="true" />
	  <!-- localization.bak isn't embedded (see SyncLocalizationIds below) - ship it loose next to the
	       dll so LocalizationService and the WinForms editor both read/write the one real file. -->
	  <Copy SourceFiles="$(MSBuildProjectDirectory)\assets\localization.bak" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\assets\localization.bak')" />
	</Target>

	<!-- every "ui.xxx"/"tweak.xxx" string literal in source is a localization id by convention - scan
	     for new ones each build and append them to assets\localization.bak with a placeholder English
	     guess, so adding new UI text never means hand-editing the table. only ever appends: existing
	     rows (and any hand-translated columns) are never touched. -->
	<Target Name="SyncLocalizationIds" BeforeTargets="BeforeCompile;CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
	  <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\sync_localization_ids.ps1&quot;" />
	</Target>

	<Target Name="PackBetterFGPayload" AfterTargets="CopyDll">
	  <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\BetterFG.Installer\repack_payload.ps1&quot; $(BettrFGDownloadsFlag) -BuildOutput &quot;$(TargetDir)&quot;" />
	</Target>

	<Target Name="PublishBetterFGInstaller" AfterTargets="PackBetterFGPayload">
	  <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\BetterFG.Installer\publish_installer.ps1&quot; $(BettrFGDownloadsFlag)" />
	</Target>

	<Target Name="PublishSkinPackager" AfterTargets="PublishBetterFGInstaller">
	  <PropertyGroup>
	    <SkinPackagerConfiguration>Release</SkinPackagerConfiguration>
	    <SkinPackagerConfiguration Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release' Or '$(Configuration)' == 'EarlyAcesss'">$(Configuration)</SkinPackagerConfiguration>
	    <SkinPackagerProject>$(MSBuildProjectDirectory)\..\BetterFG.SkinPackager\BetterFG.Creator.csproj</SkinPackagerProject>
	    <SkinPackagerOutput>$(MSBuildProjectDirectory)\..\BetterFG.SkinPackager\bin\$(SkinPackagerConfiguration)\BetterFG.Creator.dll</SkinPackagerOutput>
	    <SkinPackagerGroupBat>$(MSBuildProjectDirectory)\..\BetterFG.SkinPackager\group_skins.bat</SkinPackagerGroupBat>
	    <DownloadsDir>$(USERPROFILE)\Downloads</DownloadsDir>
	  </PropertyGroup>
	  <MSBuild Projects="$(SkinPackagerProject)" Targets="Build" Properties="Configuration=$(SkinPackagerConfiguration);Platform=AnyCPU" />
	  <MakeDir Directories="$(DownloadsDir)" Condition="'$(CopyBuildsToDownloads)' == 'true' And '$(DownloadsDir)' != '' And !Exists('$(DownloadsDir)')" />
	  <Copy SourceFiles="$(SkinPackagerOutput)" DestinationFolder="$(DownloadsDir)" OverwriteReadOnlyFiles="true" Condition="'$(CopyBuildsToDownloads)' == 'true' And Exists('$(SkinPackagerOutput)')" />
	  <Copy SourceFiles="$(SkinPackagerGroupBat)" DestinationFolder="$(DownloadsDir)" OverwriteReadOnlyFiles="true" Condition="'$(CopyBuildsToDownloads)' == 'true' And Exists('$(SkinPackagerGroupBat)')" />
	</Target>

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BetterFG</AssemblyName>
    <Product>$(BettrFGDisplayName)</Product>
    <Version>$(BettrFGVersion)</Version>
    <AssemblyVersion>$(BettrFGVersion)</AssemblyVersion>
    <FileVersion>$(BettrFGVersion)</FileVersion>
    <InformationalVersion>$(BettrFGVersion)</InformationalVersion>
    <AssemblyTitle>$(BettrFGDisplayName)</AssemblyTitle>
    <BepInExPluginName>$(BettrFGDisplayName)</BepInExPluginName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>BetterFG</RootNamespace>
    <Configurations>Debug;Release;Release_Profiles;EarlyAcesss</Configurations>
  </PropertyGroup>

  <Import Project="build\Comp.targets" Condition="Exists('$(MSBuildProjectDirectory)\build\Comp.targets')" />
  <Import Project="build\PlatformTag.targets" Condition="Exists('$(MSBuildProjectDirectory)\build\PlatformTag.targets')" />
  <Import Project="build\Obfuscation.targets" Condition="Exists('$(MSBuildProjectDirectory)\build\Obfuscation.targets')" />
  <Import Project="build\Afk.targets" Condition="Exists('$(MSBuildProjectDirectory)\build\Afk.targets')" />

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);PROFILES</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Machinima)' == 'true'">
    <DefineConstants>$(DefineConstants);MACHINIMA</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'EarlyAcesss'">
    <DefineConstants>$(DefineConstants);EARLYACESSS</DefineConstants>
  </PropertyGroup>

<Target Name="CopyDll" AfterTargets="CopyLibs" Condition="'$(SkipCopyDll)' != 'true' And ('$(CopyBuildsToSteam)' == 'true' Or '$(CopyBuildsToEpic)' == 'true')">
  <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\BetterFG.Installer\copy_plugin_to_game.ps1&quot; -Store Steam -BuildOutput &quot;$(TargetDir)&quot;" Condition="'$(CopyBuildsToSteam)' == 'true'" />
  <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\BetterFG.Installer\copy_plugin_to_game.ps1&quot; -Store Epic -BuildOutput &quot;$(TargetDir)&quot;" Condition="'$(CopyBuildsToEpic)' == 'true'" />
  <!-- launch here, right after the plugin lands, so it fires before the payload/installer/skinpackager
       chain drains. steam:// only makes sense for a Steam copy, so gate the launch on the Steam flag. -->
  <Exec Command="cmd /c start &quot;&quot; steam://rungameid/1097150" ContinueOnError="true" Condition="'$(CopyBuildsToSteam)' == 'true' And '$(SkipLaunch)' != 'true' And '$(KillAndRestartGame)' != 'false'" />
</Target>

  <!-- every asset under assets/ is embedded. drop a file in the folder and it ships, no csproj edit.
       (.png~ editor backups don't match *.png, so they stay out on their own.) localization.bak is
       NOT embedded — it ships as a loose file next to the dll (see SyncLocalizationIds/CopyLibs below)
       so the WinForms editor can touch it without a rebuild. -->
  <ItemGroup>
    <EmbeddedResource Include="assets\**\*.png" />
    <EmbeddedResource Include="assets\**\*.wav" />
    <EmbeddedResource Include="assets\**\*.ttf" />
    <EmbeddedResource Include="assets\bundles\*" />
    <EmbeddedResource Include="assets\**\*.py" />
  </ItemGroup>

