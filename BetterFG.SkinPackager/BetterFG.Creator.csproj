  <UsingTask TaskName="ShipUguiRewrite" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutDir ParameterType="System.String" Required="true" />
      <Written ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(OutDir);
        var list = new System.Collections.Generic.List<Microsoft.Build.Framework.ITaskItem>();
        foreach (var s in Sources)
        {
            string src = File.ReadAllText(s.ItemSpec);
            src = Regex.Replace(src, @"public \w+\(IntPtr ptr\) : base\(ptr\) \{ \}", "");
            src = src.Replace(".m_CachedPtr", ".CachedPtr()");
            src = src.Replace("Object.Destroy(", "Object.DestroyImmediate(");
            src = src.Replace("TMPro.TMP_FontAsset.CreateFontAsset(ttfPath, 0,", "ShipFonts.FromFile(ttfPath,");
            string dst = Path.Combine(OutDir, s.GetMetadata("RecursiveDir").Replace('\\', '_') + Path.GetFileName(s.ItemSpec));
            if (!File.Exists(dst) || File.ReadAllText(dst) != src) File.WriteAllText(dst, src);
            list.Add(new Microsoft.Build.Utilities.TaskItem(dst));
        }
        Written = list.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>
